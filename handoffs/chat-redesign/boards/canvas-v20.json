      "y": 8324
    },
    "r2opt3": {
      "fill": "green",
      "size": 24,
      "text": "Option 3 · your pick · A + B mix: one Messages inbox with a compact 'Your week' on top. Beyond this week: swipe the strip week by week ('This week' jumps back), or tap 'Your week' for the month of your RSVPs. The inbox never moves.",
      "w": 1330,
      "x": 2120,
      "y": 8324
    },
