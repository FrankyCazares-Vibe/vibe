<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme the app runs in: BridgeActivity switches to it in onCreate.
         Light rather than the template's DayNight, the same call as the iPhone
         app (UIUserInterfaceStyle Light): the site has no dark mode, so in Dark
         Mode the native dialogs it opens (confirm(), <select> lists, date
         pickers) would be dark boxes over a cream page. It names its own parent,
         so it doesn't inherit AppTheme's colours and repeats them here. The
         status bar icons start dark to suit the cream page; the StatusBar
         plugin's "LIGHT" style keeps them that way once it loads. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
