{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/waitlist-purge",
      "schedule": "17 8 * * *"
    },
    {
      "path": "/api/cron/school-checkin",
      "schedule": "47 14 * * *"
    }
  ],
  "ignoreCommand": "[ -n \"${VERCEL_GIT_PREVIOUS_SHA}\" ] && [ \"${VERCEL_GIT_PREVIOUS_SHA}\" = \"${VERCEL_GIT_COMMIT_SHA}\" ] && exit 1; git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ':!handoffs' || exit 1"
}
